{
	"name": "vektor/vk-blocks-pro",
	"authors": [
		{
			"name": "vektor,inc.",
			"email": "info@vektor-inc.co.jp"
		}
	],
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org"
		}
	],
	"require": {
		"vektor-inc/font-awesome-versions": "^0.7.5",
		"vektor-inc/vk-swiper": "^0.4.0",
		"tgmpa/tgm-plugin-activation": "dev-develop",
		"vektor-inc/vk-admin": "^0.8.0",
		"vektor-inc/vk-color-palette-manager": "^0.4.0",
		"vektor-inc/vk-helpers": "^0.3.0",
		"vektor-inc/vk-breadcrumb": "^0.2.8",
		"vektor-inc/vk-term-color": "^0.7.1",
		"vektor-inc/vk-css-optimize": "^0.2.5",
		"vektor-inc/vk-component": "^1.7.0"
	},
	"require-dev": {
		"doctrine/instantiator": "1.5.0",
		"squizlabs/php_codesniffer": "*",
		"sirbrillig/phpcs-variable-analysis": "^3.0",
		"wp-phpunit/wp-phpunit": "^7.1",
		"dealerdirect/phpcodesniffer-composer-installer": "*",
		"phpcompatibility/phpcompatibility-wp": "*",
		"wp-coding-standards/wpcs": "*",
		"yoast/phpunit-polyfills": "^4.0",
		"vektor-inc/vk-wp-unit-test-tools": "^0.12.0"
	},
	"scripts": {
		"format": "phpcbf --standard=./.phpcs.xml --report-summary --report-source",
		"lint": "phpcs --standard=./.phpcs.xml",
		"phpcs": "phpcs --standard=./.phpcs.xml"
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
